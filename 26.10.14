//26.10.14

//형변환이란 실행 중에 데이터의 타입을 변경하는 것이다.
//자동적인 형변환 - 대입연산시, 정수 연산시, 수식연산시
//명시적인 형변환

//대입연산시의 자동적인 형변환
// 
//올림 변환
//double f;
//f = 10;
//-> f에는 10.0이 저장된다.
//내림변환
//int i;
//i = 3.141592
//->i에는 3이 저장된다.
//
// 정수형끼리 형변환
// char x;
// x = 10;     // ok
// x = 10000; //상위 바이트는 없어진다.
// ->16이 x에 저장된다.
// int i;
// i = 1.23456+10;
// ->11이 저장된다.
// 정수 + 정수 -> 정수
// 정수 + 실수 -> 실수
// 
// 정수 연산시 char형이나 short형의 경우, 자동적으로 int로 (적다가 넘어가버림)
// 서로다른 자료형이 혼합하여 사용되는 경우, 더 큰 자료형으로 통일된다.
// 
// 명시적인 형변환
// (int)1.23456 //int형으로 변환
// (double) x //double형으로 변환
// (long) (x+y) //long형으로 변환
// 
//우선순위 - 어떤 연산자를 먼저 계산할 것인지에 대한 규칙
//콤마<대입<논리<관계<산술<단항
// 우선순위 생각나지 않으면 괄호를 이용하여 묶는다.
// 괄호연산자는 가장 우선순위가 높다.
//

#include<stdio.h>

int main() {
	float c, f;
	printf("화씨온도:");
	scanf_s("%f", &f);
	c = (5 / 9) * (f - 32);// 5/9 는 정수 정수 연산이기에 정수로 나와서 결과는 0이나온다. 5나 9 둘중에 하나를 실수로 바꿔서 5.0으로 바꾸던가 (float)5를 사용하면 정상작동한다. 
	printf("화씨 %f는 섭씨 %f", f, c);
}
