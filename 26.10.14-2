//제어문 - 조건문, 반복문
//3가지 제어구조 - 순차구조, 선택구조, 반복구조
//
//복합문
// 중괄호를 사용해 문장들을 그룹화함
// 블록이라고도한다.
// 
// if(x!=0)과 if(x)는 같은말이다 간략한 표기법을 사용한것.
// if(x==0)과 if(!x)도 같은 말이다.
// if(x>0);처럼 if문뒤에 ;쓰면 오류가 발생한다
//
// if-else 문
// else옆에는 (a<0)과같은 조건을 작성하지 않도록 주의한다.
//
// 조건연산자
// 간단한 if-else문은 조건연산자를 이용해 사용할 수 있다.
// bonus = ((years>30)?500:300);
// 
//

#include<stdio.h>
int main() {
	//if 문의 예
	//int a;
	//printf("정수:");
	//scanf_s("%d", &a);
	//if (a > 0)
	//	printf("양수 \n");
	//printf("끝");

	int a;
	printf("점수:");
	scanf_s("%d", &a);
	if (a > 60) {
		printf("합격 \n");
	}
	else
		printf("불합격\n");

	if (a >= 60) {
		printf("합격 \n");
	}
	if (a<60)
		printf("불합격\n");
}
